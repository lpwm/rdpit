# Normalize line endings. Text files are stored with LF in the repo and checked
# out with the platform's native endings.
* text=auto

# Windows-centric tooling scripts should stay CRLF on checkout.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Source and config: let Git normalize to LF in the repo.
*.cs       text
*.csproj   text
*.manifest text
*.md       text
*.json     text
*.gitignore text
*.gitattributes text

# Binary assets — never touch EOLs.
*.ico   binary
*.png   binary
*.exe   binary
*.dll   binary
